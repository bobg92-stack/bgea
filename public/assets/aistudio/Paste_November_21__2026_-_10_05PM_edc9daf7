#define LPC17_40_PKTMEM_SIZE     (LPC17_40_EMACRAM_SIZE-LPC17_40_DESCTAB_SIZE)
#define LPC17_40_PKTMEM_END      (LPC17_40_EMACRAM_BASE+LPC17_40_PKTMEM_SIZE)

