                if ( CmdRespStatus & (MCI_CMD_TIMEOUT) )
                {
                        LPC_MCI->CLEAR = CmdRespStatus | MCI_CMD_TIMEOUT;

                        LPC_MCI->COMMAND = 0;
                        LPC_MCI->ARGUMENT = 0xFFFFFFFF;

                        return (CmdRespStatus);
