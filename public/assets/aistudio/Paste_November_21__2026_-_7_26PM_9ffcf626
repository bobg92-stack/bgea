#  error "CONFIG_ADS7843E_SPIDEV must be zero"
#endif

#ifndef CONFIG_ADS7843E_DEVMINOR
#  define CONFIG_ADS7843E_DEVMINOR 0
#endif

#define XPT2046_NO_BUSY 1
#define TSC_Z1_THRESHOLD 200

static int  tsc_attach(struct ads7843e_config_s *state, xcpt_t isr);
static void tsc_enable(struct ads7843e_config_s *state, bool enable);
static void tsc_clear(struct ads7843e_config_s *state);
static bool tsc_busy(struct ads7843e_config_s *state);
static bool tsc_pendown(struct ads7843e_config_s *state);

static struct spi_dev_s *g_tsc_spi = NULL;
static xcpt_t g_tsc_upper_isr = NULL;
static volatile bool g_tsc_irq_fired = false;

static struct ads7843e_config_s g_tscinfo =
{
  .frequency = CONFIG_ADS7843E_FREQUENCY,
  .attach    = tsc_attach,
  .enable    = tsc_enable,
  .clear     = tsc_clear,
  .busy      = tsc_busy,
  .pendown   = tsc_pendown,
};

static int tsc_isr_wrapper(int irq, void *context, void *arg)
{
  g_tsc_irq_fired = true;
  if (g_tsc_upper_isr != NULL)
    {
      return g_tsc_upper_isr(irq, context, arg);
    }

  return OK;
}

static int tsc_attach(struct ads7843e_config_s *state, xcpt_t handler)
{
  g_tsc_upper_isr = handler;
  irq_attach(LPC17_40_IRQ_PENIRQ, tsc_isr_wrapper, NULL);
  return OK;
}

static void tsc_enable(struct ads7843e_config_s *state, bool enable)
{
  iinfo("enable:%d\n", enable);
  if (enable)
    {
      g_tsc_irq_fired = false;
      putreg32((1 << 15), LPC17_40_GPIOINT2_INTCLR);
      up_enable_irq(LPC17_40_IRQ_PENIRQ);
    }
  else
    {
      up_disable_irq(LPC17_40_IRQ_PENIRQ);
    }
}

static void tsc_clear(struct ads7843e_config_s *state)
{
  putreg32((1 << 15), LPC17_40_GPIOINT2_INTCLR);
}

static bool tsc_busy(struct ads7843e_config_s *state)
{
  return false;
}

static bool tsc_pendown(struct ads7843e_config_s *state)
{
  bool penirq = !lpc17_40_gpioread(GPIO_TC_PENIRQ);
  bool irq = g_tsc_irq_fired;
  uint8_t b0 = 0;
  uint8_t b1 = 0;
  uint16_t z1 = 0;
  bool pendown;

  g_tsc_irq_fired = false;

  if (g_tsc_spi != NULL)
    {
      SPI_SELECT(g_tsc_spi, SPIDEV_TOUCHSCREEN(0), true);
      SPI_SEND(g_tsc_spi, 0xb1);
      up_udelay(3);
      b0 = (uint8_t)SPI_SEND(g_tsc_spi, 0x00);
      b1 = (uint8_t)SPI_SEND(g_tsc_spi, 0x00);
      SPI_SELECT(g_tsc_spi, SPIDEV_TOUCHSCREEN(0), false);
      z1 = ((((uint16_t)b0 << 8) | b1) >> 3) & 0x0fff;
    }

  pendown = penirq || irq || (z1 > TSC_Z1_THRESHOLD && z1 < 3950);
  iinfo("penirq:%d irq:%d z1:%u (raw:%02x%02x) pendown:%d\n",
        (int)penirq, (int)irq, (unsigned int)z1, b0, b1, (int)pendown);
  return pendown;
}

int open1788_tsc_setup(int minor)
{
  struct spi_dev_s *dev;
  int ret;

  iinfo("minor:%d\n", minor);
  DEBUGASSERT(minor == 0);

  lpc17_40_configgpio(GPIO_TC_PENIRQ);
  lpc17_40_configgpio(GPIO_TC_CS);

#ifndef XPT2046_NO_BUSY
  lpc17_40_configgpio(GPIO_TC_BUSY);
#endif

  dev = lpc17_40_sspbus_initialize(CONFIG_ADS7843E_SPIDEV);
  if (!dev)
    {
      ierr("ERROR: Failed to initialize SPI bus %d\n",
           CONFIG_ADS7843E_SPIDEV);
      return -ENODEV;
    }

  g_tsc_spi = dev;

  ret = ads7843e_register(dev, &g_tscinfo, CONFIG_ADS7843E_DEVMINOR);
  if (ret < 0)
    {
      ierr("ERROR: Failed to register touchscreen device minor=%d\n",
           CONFIG_ADS7843E_DEVMINOR);
      return -ENODEV;
    }

  return OK;
}

